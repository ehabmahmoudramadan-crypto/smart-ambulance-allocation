import numpy as np
from scipy.optimize import linprog

class Ambulance:
    def __init__(self, ambulance_id: str, station_id: str):
        self.id = ambulance_id
        self.station_id = station_id
        self.state = "Available"
        self.current_location = station_id

class Incident:
    def __init__(self, incident_id: int, location: str, arrival_time: float):
        self.id = incident_id
        self.location = location
        self.arrival_time = arrival_time
        self.status = "Pending"

class TransportationOptimizer:
    @staticmethod
    def solve_optimal_allocation(supply, demand, cost_matrix, closed_roads=None, capacities=None):
        m, n = cost_matrix.shape
        c = cost_matrix.flatten()
        
        A_eq, b_eq = [], []
        for i in range(m):
            row = np.zeros((m, n))
            row[i, :] = 1
            A_eq.append(row.flatten())
            b_eq.append(supply[i])
            
        for j in range(n):
            col = np.zeros((m, n))
            col[:, j] = 1
            A_eq.append(col.flatten())
            b_eq.append(demand[j])
            
        A_eq = np.array(A_eq)
        b_eq = np.array(b_eq)
        
        bounds = []
        for i in range(m):
            for j in range(n):
                upper = np.inf
                if closed_roads and (i, j) in closed_roads:
                    upper = 0
                if capacities and (i, j) in capacities:
                    upper = min(upper, capacities[(i, j)])
                bounds.append((0, upper))
                
        res = linprog(c, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
        if res.success:
            allocation_matrix = res.x.reshape((m, n)).round().astype(int)
            total_cost = np.sum(allocation_matrix * np.where(cost_matrix > 1e6, 0, cost_matrix))
            return allocation_matrix, total_cost
        else:
            raise ValueError("Optimization failed: " + res.message)

class RoadNetwork:
    def __init__(self, stations, areas, cost_matrix):
        self.stations = stations
        self.areas = areas
        self.roads = {}
        for i, s in enumerate(stations):
            for j, a in enumerate(areas):
                self.roads[(s, a)] = cost_matrix[i][j]

    def get_cost(self, u: str, v: str) -> float:
        return self.roads.get((u, v), float('inf'))

class DispatcherAgent:
    def __init__(self, ambulances: list, allocation_matrix, stations, areas, road_network):
        self.ambulances = ambulances
        self.allocation_plan = allocation_matrix
        self.stations = stations
        self.areas = areas
        self.road_network = road_network
        
        self.remaining_quota = {}
        for i, s in enumerate(stations):
            for j, a in enumerate(areas):
                self.remaining_quota[(s, a)] = int(allocation_matrix[i][j])
                
        self.response_times = []

    def dispatch_ambulance(self, incident: Incident):
        target_area = incident.location
        print(f"\n--- [Dispatch Attempt] Incident #{incident.id} at Location '{target_area}' ---")

        best_station = None
        for i, s in enumerate(self.stations):
            if self.remaining_quota[(s, target_area)] > 0:
                available_ambs = [amb for amb in self.ambulances if amb.station_id == s and amb.state == "Available"]
                if available_ambs:
                    best_station = s
                    break

        if not best_station:
            min_cost = float('inf')
            for amb in self.ambulances:
                if amb.state == "Available":
                    cost = self.road_network.get_cost(amb.station_id, target_area)
                    if cost < min_cost:
                        min_cost = cost
                        best_station = amb.station_id

        if best_station:
            available_ambs = [amb for amb in self.ambulances if amb.station_id == best_station and amb.state == "Available"]
            if available_ambs:
                selected_amb = available_ambs[0]
                selected_amb.state = "Dispatched"
                selected_amb.current_location = target_area
                incident.status = "Assigned"
                
                if self.remaining_quota.get((best_station, target_area), 0) > 0:
                    self.remaining_quota[(best_station, target_area)] -= 1

                response_time = self.road_network.get_cost(best_station, target_area)
                self.response_times.append(response_time)
                
                print(f"  ✔ [SUCCESS] Assigned Ambulance [{selected_amb.id}] from Station [{best_station}]")
                print(f"    ⏱ Response Time: {response_time} minutes")
                return selected_amb

        print(f"    [FAILED] No available ambulance for Incident #{incident.id}!")
        return None

    def print_performance_summary(self):
        print("\n==================================================================")
        print("                  SIMULATION PERFORMANCE SUMMARY                  ")
        print("==================================================================")
        if self.response_times:
            avg_time = sum(self.response_times) / len(self.response_times)
            print(f"  Total Dispatched Incidents : {len(self.response_times)}")
            print(f"  Average Response Time      : {avg_time:.2f} minutes")
            print(f"  Max Response Time          : {max(self.response_times)} minutes")
            print(f"  Min Response Time          : {min(self.response_times)} minutes")
        else:
            print("  No incidents were dispatched.")
        print("==================================================================")

